$ in_image iocs:dev env COREUTILS_HOME=/iocs/build/coreutils/coreutils-8.31 IOCS_RESULT_DIR=/iocs/build/sweep/result bash -c 
        rw() {
            # tree: start again from the compiler's objects (a rerun must not rewrite rewritten code)
            if [ "${IOCS_REWRITE_MODE:-}" = tree ]; then rm -f "/iocs/build/sweep/result/$1"/*.s.bak "/iocs/build/sweep/result/$1"/table.c "/iocs/build/sweep/result/$1"/trees.txt
                bash benchmarks/coreutils/coreutils.sh "$1" migrate > /dev/null 2>&1 || { echo "SWEEP $1 rewrite rc=restore"; return; }; fi
            timeout 1800 ./iocs.sh "$1" rewrite > build/sweep/logs/$1.rewrite.log 2>&1; rc=$?; echo "SWEEP $1 rewrite rc=$rc"; }
        export -f rw
        for u; do [ -s "/iocs/build/sweep/result/$u/$u.analysis" ] && echo "$u"; done | xargs -P 4 -I{} bash -c "rw {}" _ chroot hostid timeout nice who users pinky uptime stty df stdbuf b2sum base64 base32 basenc basename cat chcon chgrp chmod chown cksum comm cp csplit cut date dd dir dircolors dirname du echo env expand expr factor false fmt fold ginstall groups head id join kill link ln logname ls md5sum mkdir mkfifo mknod mktemp mv nl nproc nohup numfmt od paste pathchk pr printenv printf ptx pwd readlink realpath rm rmdir runcon seq sha1sum sha224sum sha256sum sha384sum sha512sum shred shuf sleep sort split stat sum sync tac tail tee test touch tr true truncate tsort tty uname unexpand uniq unlink vdir wc whoami yes
SWEEP hostid rewrite rc=0
SWEEP nice rewrite rc=0
SWEEP chroot rewrite rc=0
SWEEP timeout rewrite rc=0
