> # ---- Multiplication ---- #
> .macro imul_store_gs operand, offset, value
> 	rdgsbase %r10
> 	mov	\offset(%r10), %r10 
> 	rdgsbase %r11
> 	mov	\offset(%r11), %r11
> 	.if \value == 8
> 	mov (%r11), %r11b   # (multiply the page's value, in %r11, not the 6th-argument register %r9)
> 	imul \operand, %r11b  # 8-bit 
> 	mov %r11b, (%r10)
> 	.elseif \value == 16
> 	mov (%r11), %r11w
> 	imul \operand, %r11w  # 16-bit 
> 	mov %r11w, (%r10)
> 	.elseif \value == 32
> 	mov (%r11), %r11d
> 	imul \operand, %r11d  # 32-bit 
> 	mov %r11d, (%r10)
> 	.elseif \value == 64
> 	mov (%r11), %r11
> 	imul \operand, %r11   # 64-bit 
> 	mov %r11, (%r10)
> 	.endif
> .endm
> 
> .macro imul_load_gs dest, offset, value
> 	rdgsbase %r11
> 	mov \offset(%r11), %r11
> 	.if \value == 8
> 	mov (%r11), %r10b
> 	imul %r10b, \dest  # 8-bit 
> 	.elseif \value == 16
> 	mov (%r11), %r10w
> 	imul %r10w, \dest  # 16-bit 
> 	.elseif \value == 32
> 	mov (%r11), %r10d
> 	imul %r10d, \dest  # 32-bit 
> 	.elseif \value == 64
> 	mov (%r11), %r10
> 	imul %r10, \dest   # 64-bit 
> 	.endif
> .endm
