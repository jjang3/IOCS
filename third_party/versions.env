# Every external component IOCS builds against, in one place. Read by third_party/get_pin.sh,
# third_party/build_suture.sh, benchmarks/nginx/build_nginx.sh, scripts/*.sh, and (as --build-arg
# values passed by scripts/build_images.sh) docker/Dockerfile. Submodule SHAs are recorded here
# for reference; git's own gitlinks are authoritative (scripts/setup.sh checks they agree).
# Changing NGINX_VERSION also needs a matching benchmarks/nginx/patches/nginx-<version>-*.patch set.

# Intel PIN (not redistributable as a submodule: downloaded and checksummed by get_pin.sh)
PIN_NAME=pin-3.27-98718-gbeaa5d51e-gcc-linux
PIN_URL=https://software.intel.com/sites/landingpage/pintool/downloads/pin-3.27-98718-gbeaa5d51e-gcc-linux.tar.gz
PIN_SHA256=e7d44d25668632007d5a109e5033415e91db543b8ce9e665893a05e852b67707

# libdft64 (submodule third_party/libdft64)
LIBDFT64_SHA=066c9d8b3eaa7eeb353dc51771948f3dc8062f95

# SUTURE (submodule third_party/SUTURE; 6c113b0 = README-only commits on top of 7036d64)
SUTURE_SHA=6c113b0e8a869d44f278b0d098387d7ab96f113e
# LLVM/clang 9 for SUTURE: the llvm-mirror release_90 heads that SUTURE's setup_suture.py clones
LLVM_MIRROR_LLVM_SHA=c2f5309b216cb02a0aae17353549d985b5b05635
LLVM_MIRROR_CLANG_SHA=bed37d4b18ce6993fc2567e8de61f6b30fd0cb75

# GNU coreutils (benchmarks/coreutils): the release the paper evaluated
COREUTILS_VERSION=8.31
COREUTILS_SHA256=ff7a9c918edce6b4f4b2725e3f9b37b0c4d193531cac49a48b56c4d0d3a9e9fd

# Nginx (benchmarks/nginx)
NGINX_VERSION=1.3.9
NGINX_SHA256=30463a867614bed304f6c02f6a35ff697ec70c227d87af0772a417ee05f548df

# Binary Ninja (commercial; never in the repo): the Linux zip and licence are supplied locally
BINARYNINJA_VERSION=3.1.3469

# Python packages for the pipeline
PYELFTOOLS_VERSION=0.29
TERMCOLOR_VERSION=2.4.0
