# Copy to config.env (git-ignored) and adjust.
#
# Required for scripts/setup.sh and scripts/build_images.sh:
# Binary Ninja 3.1.3469 for Linux (commercial; never commit it). The file must be named
# BinaryNinjaLinux.zip (docker/Dockerfile reads it under that name).
BN_LINUX_ZIP=
# Binary Ninja licence file. Default: ~/Library/Application Support/Binary Ninja/license.dat (macOS)
# or ~/.binaryninja/license.dat.
#BN_LICENSE=
#
# Optional (scripts/lib.sh): colima profile names and sizes on macOS.
#BUILD_PROFILE=iocs-rosetta
#RUN_PROFILE=iocs-x86
#BUILD_PROFILE_ARGS="--arch aarch64 --vm-type vz --vz-rosetta --cpu 8 --memory 14 --disk 80"
#RUN_PROFILE_ARGS="--arch x86_64 --vm-type qemu --cpu 4 --memory 8 --disk 60"
# Native Linux: docker context to use (default: default).
#IOCS_DOCKER_CONTEXT=default
#
# Everything below is optional; the defaults match the Docker image (docker/Dockerfile).

# Defaults: inside the iocs:dev image the tools live under /opt; on a host they come from
# third_party/ (get_pin.sh, build_suture.sh). Override only if yours are elsewhere.
# SUTURE checkout with llvm_analysis built and benchmark/ writable.
#SUTURE_HOME=/opt/suture                      # host: third_party/SUTURE
# SUTURE's LLVM 9 build; clang is $LLVM_ROOT/bin/clang unless SUTURE_CLANG is set.
#LLVM_ROOT=/opt/suture_deps/llvm/build        # host: third_party/.deps/llvm/build
# Seconds to wait for SUTURE's "Bug Detection Phase finished" marker.
#SUTURE_TIMEOUT=3600

# Intel PIN 3.27 kit root (pin-3.27-98718-gbeaa5d51e-gcc-linux).
#PIN_ROOT=/opt/pin-3.27                       # host: third_party/pin/pin-3.27
# libdft64 source (submodule).
#LIBDFT64=third_party/libdft64

# Binary Ninja 3.1.3469 Python API. The licence file is never committed; mount it at
# ~/.binaryninja/license.dat (Linux) or ~/Library/Application Support/Binary Ninja/license.dat (macOS).
#PYTHONPATH=/opt/binaryninja/python

# Rewriter: directory (default: every local of the DTA-traced functions) or tree (pointer offset
# trees over SUTURE's tainted variables; needs <t>.taint and <t>.vuln). See RESULTS.md.
#IOCS_REWRITE_MODE=directory
